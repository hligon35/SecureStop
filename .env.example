EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.us.sentry.io/0

# Firebase client config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Supabase client config
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_SCHEMA=public

# Multi-tenant bootstrapping
# Supports JSON or CSV format: tenant-a:Tenant A,tenant-b:Tenant B
EXPO_PUBLIC_TENANTS=mock-school:Demo School

# Cloudflare domain event forwarding
EXPO_PUBLIC_CLOUDFLARE_EVENTS_BASE_URL=
EXPO_PUBLIC_CLOUDFLARE_EVENTS_PATH=/events/domain

# OIDC auth
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_REDIRECT_URI=
EXPO_PUBLIC_OIDC_SCOPES=openid profile email

# Feature flags
EXPO_PUBLIC_ENABLE_DEMO_LOGIN=false
EXPO_PUBLIC_ENABLE_DRIVER_GPS=false
EXPO_PUBLIC_ENABLE_PUSH_TOKEN_REGISTRATION=true