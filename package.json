{
  "name": "securestop",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "cloudflare:dev": "npx wrangler dev --config cloudflare/wrangler.toml",
    "cloudflare:deploy": "npx wrangler deploy --config cloudflare/wrangler.toml",
    "cloudflare:test:relay": "node cloudflare/testRelayFixture.mjs",
    "cloudflare:test:worker": "node cloudflare/testWorkerFixture.mjs",
    "ios:build:internal": "eas build --platform ios --profile internal",
    "ios:build:appstore": "eas build --platform ios --profile production",
    "ios:submit:testflight": "eas submit --platform ios --profile production",
    "ios:release:testflight": "eas build --platform ios --profile production --auto-submit",
    "ota:publish:production": "eas update --channel production",
    "ota:publish:production:clear-cache": "eas update --channel production --clear-cache",
    "ota:publish:internal": "eas update --channel internal",
    "ota:publish:internal:clear-cache": "eas update --channel internal --clear-cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^8.11.1",
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.13.2",
    "expo": "~54.0.31",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.10",
    "firebase": "^11.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
